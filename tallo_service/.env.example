# Backend config (internal/config). Copy to .env and fill in, or export directly.
# Money is int64 satang everywhere; these are just connection/runtime settings.

# Postgres connection. Locally: the docker one-liner in CLAUDE.md.
# In prod use Neon's POOLED connection string.
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres?sslmode=disable

# HTTP port (defaults to 8080 if unset).
PORT=8080

# Allowed browser origin for CORS. Empty disables CORS headers (same-origin/dev).
# In prod set to your Vercel URL, e.g. https://tallo.vercel.app
CORS_ORIGIN=http://localhost:3000
